{
  "name": "story-book-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "vite build --mode staging",
    "start": "vite preview --mode staging",
    "lint": "eslint",
    "test": "tsx --test tests/core.test.ts tests/workspace-client.test.ts tests/partial-autofill.test.ts tests/publishing-results.test.ts tests/refinement.test.ts tests/batch-storage.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build --mode staging",
    "start:vinext": "vite preview --mode staging",
    "deploy:vinext": "vinext-cloudflare deploy --env staging",
    "build:next": "next build",
    "deploy:staging": "node scripts/deploy-staging.mjs",
    "deploy:production": "node scripts/release-production.mjs",
    "check:vinext": "vinext check",
    "test:worker": "node scripts/test-worker.mjs",
    "start:next": "next start --hostname 127.0.0.1"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "image-size": "^2.1.0",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "latest",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.3.3",
    "@vitejs/plugin-react": "latest",
    "@vitejs/plugin-rsc": "latest",
    "cf": "1.0.0-beta.28",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "node": "24.22.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vinext": "1.4.4",
    "vite": "8.3.6",
    "wrangler": "^4.158.0"
  },
  "type": "module"
}
